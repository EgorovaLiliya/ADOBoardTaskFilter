<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_asis" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_asis"><bpmn:participant id="Pool_asis" name="AS-IS: подготовка к обсуждению работы участника" processRef="Proc_asis"/></bpmn:collaboration>
  <bpmn:process id="Proc_asis" isExecutable="false">
    <bpmn:laneSet id="LS_asis">
      <bpmn:lane id="L_lead" name="Ведущий встречи">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ado" name="Azure DevOps Server">
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Нужно обсудить работу участника"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="A1" name="Открыть доску команды"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A2" name="Отобразить доску"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="A3" name="Открыть следующую карточку"><bpmn:incoming>F3</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A4" name="Отобразить карточку с дочерними Task"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="A5" name="Просмотреть исполнителей Task"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Участник среди исполнителей?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="A6" name="Выписать номер карточки"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name=""><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="Остались карточки без просмотра?"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="A7" name="Обсудить работу по выписанным карточкам"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E1" name="Работа участника обсуждена"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="A1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="A1" targetRef="A2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="A2" targetRef="A3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="A3" targetRef="A4"/>
    <bpmn:sequenceFlow id="F5" sourceRef="A4" targetRef="A5"/>
    <bpmn:sequenceFlow id="F6" sourceRef="A5" targetRef="G1"/>
    <bpmn:sequenceFlow id="F7" name="да" sourceRef="G1" targetRef="A6"/>
    <bpmn:sequenceFlow id="F8" name="нет" sourceRef="G1" targetRef="G2"/>
    <bpmn:sequenceFlow id="F9" sourceRef="A6" targetRef="G2"/>
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="G3"/>
    <bpmn:sequenceFlow id="F11" name="да" sourceRef="G3" targetRef="A3"/>
    <bpmn:sequenceFlow id="F12" name="нет" sourceRef="G3" targetRef="A7"/>
    <bpmn:sequenceFlow id="F13" sourceRef="A7" targetRef="E1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_asis"><bpmndi:BPMNPlane id="Plane_asis" bpmnElement="Collab_asis">
    <bpmndi:BPMNShape id="Pool_asis_di" bpmnElement="Pool_asis" isHorizontal="true"><dc:Bounds x="80" y="80" width="2290" height="440"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_lead_di" bpmnElement="L_lead" isHorizontal="true"><dc:Bounds x="110" y="80" width="2260" height="270"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_ado_di" bpmnElement="L_ado" isHorizontal="true"><dc:Bounds x="110" y="350" width="2260" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="192.0" y="197.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="160.0" y="239.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A1_di" bpmnElement="A1"><dc:Bounds x="315.0" y="175.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A2_di" bpmnElement="A2"><dc:Bounds x="490.0" y="395.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A3_di" bpmnElement="A3"><dc:Bounds x="665.0" y="175.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A4_di" bpmnElement="A4"><dc:Bounds x="840.0" y="395.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A5_di" bpmnElement="A5"><dc:Bounds x="1015.0" y="175.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1235.0" y="190.0" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1117.0" y="146.0" width="110" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A6_di" bpmnElement="A6"><dc:Bounds x="1365.0" y="105.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="1585.0" y="190.0" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="1760.0" y="190.0" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1720.0" y="246.0" width="130" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A7_di" bpmnElement="A7"><dc:Bounds x="1890.0" y="175.0" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="2117.0" y="197.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2085.0" y="239.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="228.0" y="215.0"/><di:waypoint x="315.0" y="215.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="455.0" y="215.0"/><di:waypoint x="472.5" y="215.0"/><di:waypoint x="472.5" y="435.0"/><di:waypoint x="490.0" y="435.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="630.0" y="435.0"/><di:waypoint x="647.5" y="435.0"/><di:waypoint x="647.5" y="215.0"/><di:waypoint x="665.0" y="215.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="805.0" y="215.0"/><di:waypoint x="822.5" y="215.0"/><di:waypoint x="822.5" y="435.0"/><di:waypoint x="840.0" y="435.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="980.0" y="435.0"/><di:waypoint x="997.5" y="435.0"/><di:waypoint x="997.5" y="215.0"/><di:waypoint x="1015.0" y="215.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1155.0" y="215.0"/><di:waypoint x="1235.0" y="215.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1260.0" y="190.0"/><di:waypoint x="1260.0" y="145.0"/><di:waypoint x="1365.0" y="145.0"/><bpmndi:BPMNLabel><dc:Bounds x="1266.0" y="166.0" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1260.0" y="240.0"/><di:waypoint x="1260.0" y="285.0"/><di:waypoint x="1610.0" y="285.0"/><di:waypoint x="1610.0" y="240.0"/><bpmndi:BPMNLabel><dc:Bounds x="1266.0" y="246.0" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1505.0" y="145.0"/><di:waypoint x="1610.0" y="145.0"/><di:waypoint x="1610.0" y="190.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1635.0" y="215.0"/><di:waypoint x="1760.0" y="215.0"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1785.0" y="190.0"/><di:waypoint x="1785.0" y="94"/><di:waypoint x="735.0" y="94"/><di:waypoint x="735.0" y="175.0"/><bpmndi:BPMNLabel><dc:Bounds x="1791.0" y="166.0" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1810.0" y="215.0"/><di:waypoint x="1890.0" y="215.0"/><bpmndi:BPMNLabel><dc:Bounds x="1818.0" y="195.0" width="30" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="2030.0" y="215.0"/><di:waypoint x="2117.0" y="215.0"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>